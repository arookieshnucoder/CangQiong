<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-01-insert-default-admin" author="sky">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM employee WHERE username = 'admin'
            </sqlCheck>
        </preConditions>

        <insert tableName="employee">
            <column name="name" value="管理员"/>
            <column name="username" value="admin"/>
            <column name="password" value="e10adc3949ba59abbe56e057f20f883e"/>
            <column name="phone" value="13800000000"/>
            <column name="sex" value="1"/>
            <column name="id_number" value="110101199001010010"/>
            <column name="status" valueNumeric="1"/>
            <column name="create_time" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="update_time" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>

        <rollback>
            <delete tableName="employee">
                <where>username = 'admin'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>